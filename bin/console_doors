#!/usr/bin/env bash
# WHICH MODELS CAN AN OPERATOR REACH?
#
# Needs the Rails environment, so it re-execs itself through `bin/rails runner`.
# The first version carried a `#!/usr/bin/env ruby` shebang and was chmod +x,
# which made it LOOK runnable and fail with `uninitialized constant Rails` —
# a tool that cannot be invoked, in a week spent finding code that cannot be
# reached.
exec "$(dirname "$0")/rails" runner "$(dirname "$0")/../script/console_doors.rb"
