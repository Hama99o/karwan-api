#!/usr/bin/env bash
# Is the stack ready, IN ORDER, and is it OURS?
#
# ── Why this exists ───────────────────────────────────────────────────────
# The first device run of this app produced twelve findings and TWO of them
# were nothing to do with the app: nothing was serving the API at all
# (UI_FINDINGS.md F-06), and the rig's own health check was pointed at another
# application on port 3000 and then at an endpoint this API does not have
# (F-13). Three separate bugs from one root — the order was assumed rather than
# checked, and "something answered" was taken for "the right thing answered".
#
# So this checks the order, bottom up, and each step names the exact command
# that fixes it. It is READ-ONLY: it starts nothing and migrates nothing,
# because a QA run may own the server right now and two processes fighting for
# one port is a worse failure than a clear message.
#
# ── The rule it enforces, which is the whole point ────────────────────────
# A STATUS CODE IS NOT AN IDENTITY. `doctor` once reported a green API against
# an unrelated Rails app on 3000. So step 4 asserts the payload is KARWAN'S —
# a 200 from a stranger fails here.
#
# Usage:  bin/preflight            # check and report
#         bin/preflight --quiet    # exit code only, for a script
set -uo pipefail

QUIET=0
[ "${1:-}" = "--quiet" ] && QUIET=1

PORT="${PORT:-3017}"
API="http://localhost:$PORT"
PG_PORT="${PG_PORT:-5417}"
METRO_PORT="${METRO_PORT:-3028}"
FAILED=0

say()  { [ "$QUIET" = 1 ] || printf '%s\n' "$*"; }
ok()   { say "  ✓ $*"; }
bad()  { say "  ✗ $*"; FAILED=1; }
note() { say "    → $*"; }
step() { say ""; say "$*"; }

# ── 1 · Postgres ──────────────────────────────────────────────────────────
step "1/5  Postgres on :$PG_PORT"
if (exec 3<>"/dev/tcp/localhost/$PG_PORT") 2>/dev/null; then
  ok "accepting connections"
else
  bad "nothing listening on :$PG_PORT"
  note "docker compose up -d        (from karwan-api/)"
fi

# ── 2 · Schema ────────────────────────────────────────────────────────────
# Asked of Rails rather than of psql: the credentials live in database.yml and
# duplicating them here is how the two drift apart.
step "2/5  Schema up to date"
# `connection_pool.migration_context`, not `connection.migration_context` —
# the latter was removed and raises NoMethodError, which this script reported
# as "could not ask Rails" against a perfectly migrated database. A check that
# fails closed on its own bug is still a wrong answer.
PENDING=$(bin/rails runner 'print ActiveRecord::Base.connection_pool.migration_context.needs_migration? ? "yes" : "no"' 2>/dev/null)
case "$PENDING" in
  no)  ok "no pending migrations" ;;
  yes) bad "migrations are pending"; note "bin/rails db:prepare" ;;
  *)   bad "could not ask Rails (is Postgres up, and the database created?)"
       note "bin/rails db:prepare" ;;
esac

# ── 3 · The API is answering ──────────────────────────────────────────────
step "3/5  API on :$PORT"
UP=$(curl -s -o /dev/null -m 5 -w '%{http_code}' "$API/up" 2>/dev/null)
if [ "$UP" = "200" ]; then
  ok "/up returns 200"
else
  bad "/up returned '${UP:-no response}'"
  note "bin/rails s                 (3017 is the DEFAULT now — do not pass -p)"
fi

# ── 4 · …AND IT IS KARWAN ─────────────────────────────────────────────────
# The step the rig was missing twice over. A stranger on this port returns a
# perfectly good 200.
step "4/5  …and it is KARWAN, not another app on the port"
BODY=$(curl -s -m 5 "$API/api/v1/public/merchant_categories" 2>/dev/null)
if printf '%s' "$BODY" | grep -q '"merchant_categories"'; then
  ok "public/merchant_categories is ours"
  if printf '%s' "$BODY" | grep -q '"slug"'; then
    ok "reference data seeded"
  else
    bad "no categories — reference data is missing"
    note "bin/rails db:seed"
  fi
else
  bad "that endpoint is not Karwan's (got: $(printf '%s' "${BODY:-empty}" | head -c 60))"
  note "something else is on :$PORT — check before believing any green line"
fi

# ── 5 · Sample data, so the screens have something true to show ───────────
# There is no fake data left in the app (correction 17), so an unseeded
# database means every screen correctly shows an empty state and a device run
# proves nothing about layout.
step "5/5  Sample data for the screens"
MERCHANTS=$(curl -s -m 5 "$API/api/v1/public/merchants" 2>/dev/null)
# `grep -F`: a literal. `\{` is not valid in a basic regex and grep said so on
# stderr while returning non-zero, so this reported "no merchants" against a
# seeded database — the false negative twin of the false green this file exists
# to prevent.
if printf '%s' "$MERCHANTS" | grep -qF '"merchants":[{'; then
  ok "merchants are browsable"
else
  bad "no merchants — every screen will show its empty state"
  note "bin/rails db:seed           (sample data is skipped in production only)"
fi

# ── A warning, not a failure: where files are served from ─────────────────
#
# A deployed API inferring `http://localhost` for photo URLs would look correct
# in every log and show nothing on every phone — the failure is invisible from
# the server side, which is exactly why it is worth saying out loud here.
step "File URLs (warning only)"
FILE_BASE=$(RAILS_ENV=${RAILS_ENV:-development} bin/rails runner 'print Attachments::PublicUrl.base_url' 2>/dev/null)
if [ -z "${APP_BASE_URL:-}${KAMAL_HOST:-}" ]; then
  say "  · APP_BASE_URL is unset — photo and voice-note URLs will use $FILE_BASE."
  say "    Fine locally. On a deployed box it means a phone fetches localhost."
else
  ok "Files served from $FILE_BASE"
fi

# ── A warning, not a failure: SMS ─────────────────────────────────────────
# The log adapter is correct for development and fatal in production — every
# user waits for a code that never arrives while the server looks healthy. It
# does not block a local run, so it warns rather than failing.
step "SMS (warning only)"
if [ "${SMS_PROVIDER:-log}" = "log" ]; then
  say "  · SMS_PROVIDER is 'log' — codes are written to the log, not sent."
  note "fine locally; in production nobody can sign in. Hamma9900 picks the gateway."
else
  ok "SMS_PROVIDER=$SMS_PROVIDER"
fi

# ── THE CONFIG SCREEN HAMMA9900 TUNES FROM ────────────────────────────────
#
# Correction 13's whole premise is that he retunes prices weekly from the
# console **with no deploy**. The console lists `settings` ROWS, not
# `Setting::DEFINITIONS` — and `Setting.fetch` falls back to a definition's
# default when no row exists. So a database that has never been seeded runs
# perfectly, prices orders correctly, and shows him a Config screen that is
# simply SHORT. There is no error anywhere, and the premise quietly does not
# hold.
#
# `config/deploy.yml` puts `seed` under `aliases:` — a shortcut somebody types,
# not a hook — and there is no `.kamal/hooks/`. hatiwal-api is the same, so
# manual is the established practice here and this check does not fight it: it
# makes FORGETTING VISIBLE, which is the actual defect.
#
# It also catches the likelier future version: a definition added in a later
# release and never seeded on the running server.
step "Config rows"
MISSING=$(bin/rails runner '
  missing = Setting::DEFINITIONS.keys - Setting.pluck(:key)
  print missing.join(" ")
' 2>/dev/null)
MISSING_COUNT=$(printf "%s" "$MISSING" | wc -w | tr -d " ")

if [ "$MISSING_COUNT" = "0" ]; then
  ok "every setting has a row he can edit"
elif [ -n "${APP_BASE_URL:-}${KAMAL_HOST:-}" ] || [ "${RAILS_ENV:-development}" = "production" ]; then
  bad "$MISSING_COUNT setting(s) have no row on a DEPLOYED box — he cannot tune them."
  note "missing: $MISSING"
  note "bin/rails db:seed   (reference data only in production; never overwrites a tuned value)"
else
  say "  · $MISSING_COUNT setting(s) have no row yet — the Config screen would be short."
  note "missing: $MISSING"
  note "bin/rails db:seed"
fi

# ── A ROW IS NOT A VALUE ──────────────────────────────────────────────────
#
# The check above asks whether every setting HAS A ROW. It does not ask whether
# the row has anything in it, and three of them ship with an empty default
# because nobody but Hamma9900 can supply them.
#
# Found 2026-09-18: `top_up_bank_name` and `top_up_account_number` are both "",
# and they are the entire content of a courier's top-up instructions. CLAUDE.md
# makes a bank deposit referenced by a numeric code THE way a courier adds
# credit in v0 — so with these blank, a courier whose wallet runs out cannot
# top up, and dispatch stops offering them work. The API serves the field, the
# screen would render two empty lines, and nothing anywhere says why.
#
# DERIVED, not listed: any definition whose default is blank is by construction
# one we cannot supply. A new one joins this check without anybody editing it.
step "Settings only he can fill"
BLANK=$(bin/rails runner '
  blank = Setting::DEFINITIONS.select { |_k, d| d[:default].to_s.strip.empty? }
  print blank.keys.reject { |k| Setting.fetch(k).to_s.strip.present? }.join(" ")
' 2>/dev/null)
BLANK_COUNT=$(printf "%s" "$BLANK" | wc -w | tr -d " ")

if [ "$BLANK_COUNT" = "0" ]; then
  ok "every setting that needs a human has one"
elif [ -n "${APP_BASE_URL:-}${KAMAL_HOST:-}" ] || [ "${RAILS_ENV:-development}" = "production" ]; then
  bad "$BLANK_COUNT setting(s) are EMPTY on a DEPLOYED box."
  note "empty: $BLANK"
  note "a blank top_up_* means a courier cannot add credit, and dispatch stops offering them work"
  note "fill them in the Config screen — no deploy needed"
else
  say "  · $BLANK_COUNT setting(s) are still empty — fine locally, fails on a deployed box."
  note "empty: $BLANK"
fi

# ── CAN THIS BOX ACTUALLY MAKE A THUMBNAIL? ───────────────────────────────
#
# Every image a phone fetches is served as a VARIANT: measured through libvips
# on a real photograph, a merchant logo goes from ~1 MB to 16.8 KB and a
# storefront to 65.9 KB. `rails_representation_path` is lazy, so a box with no
# image library would serve a URL that 500s on first fetch — which is why
# `Attachments::PublicUrl` degrades to the ORIGINAL instead.
#
# THAT FALLBACK IS A KINDNESS ON A LAPTOP AND A DISASTER ON A SERVER. Degraded,
# the Home screen serves twenty camera frames — ~20 MB measured against the dev
# seed — to users paying Kabul data prices. So a deployed box FAILS here while a
# dev box is told once and left alone.
#
# The production image has `libvips` in both Dockerfile stages; this catches the
# day somebody trims it out of the runtime layer to save 40 MB.
step "Image variants"
VARIANTS=$(bin/rails runner 'print Attachments::PublicUrl.variants_processable? ? "yes" : "no"' 2>/dev/null)

if [ "$VARIANTS" = "yes" ]; then
  ok "thumbnails can be generated"
elif [ -n "${APP_BASE_URL:-}${KAMAL_HOST:-}" ] || [ "${RAILS_ENV:-development}" = "production" ]; then
  bad "no image library on a DEPLOYED box — every photo would be served at full camera resolution."
  note "the Home screen measured ~20 MB of originals against ~1.3 MB of variants"
  note "install libvips (it is in both Dockerfile stages; check the runtime layer)"
else
  say "  · no libvips here, so photos are served unresized — fine locally, fails on a deployed box."
  note "the API degrades to the original rather than serving a URL that 500s"
fi

# ── A DECLARED SECRET IS NOT A SUPPLIED ONE ───────────────────────────────
#
# The step above covers `Setting` rows. It cannot see ENV, and two of the keys
# that decide whether this platform can talk to anybody live there:
# `FCM_PROJECT_ID` and `FCM_ACCESS_TOKEN`.
#
# What happens without them is deliberate and correct — `Notifications::FcmClient`
# returns `status: :unconfigured` and logs, because a missing push must not fail
# an order. But PRODUCT.md is explicit that a merchant who never hears the alert
# is the most damaging state in the system: a tablet in a loud kitchen that never
# makes a sound, and an order going cold while somebody waits.
#
# DERIVED FROM `config/deploy.yml`, not listed here: whatever is declared under
# `env.secret` is what a deployed box is expected to supply, so a new secret
# joins this check by being declared. The exceptions are named with the reason,
# the same shape as the variant gate's SERVED_WHOLE.
step "Declared secrets that are empty"
SECRETS=$(bin/rails runner '
  require "yaml"
  declared = YAML.load_file(Rails.root.join("config/deploy.yml"), aliases: true)
                 .dig("env", "secret") || []
  # Covered by their own steps above, so reporting them here is noise.
  covered = %w[SMTP_ADDRESS SMTP_USER_NAME SMTP_PASSWORD SMS_PROVIDER]
  # Supplied by the deploy tooling itself rather than by him.
  tooling = %w[RAILS_MASTER_KEY DATABASE_PASSWORD KAMAL_REGISTRY_PASSWORD]
  print (declared - covered - tooling).reject { |k| ENV[k].to_s.strip.present? }.join(" ")
' 2>/dev/null)
SECRETS_COUNT=$(printf "%s" "$SECRETS" | wc -w | tr -d " ")

if [ "$SECRETS_COUNT" = "0" ]; then
  ok "every declared secret has a value"
elif [ -n "${APP_BASE_URL:-}${KAMAL_HOST:-}" ] || [ "${RAILS_ENV:-development}" = "production" ]; then
  bad "$SECRETS_COUNT declared secret(s) are EMPTY on a DEPLOYED box."
  note "empty: $SECRETS"
  note "with no FCM credentials the merchant alert is silent — PRODUCT.md calls that the"
  note "most damaging state in the system, and the audit row that flags it is not on a screen"
else
  say "  · $SECRETS_COUNT declared secret(s) are empty — fine locally, fails on a deployed box."
  note "empty: $SECRETS"
fi

# ── CAN ANYBODY ACTUALLY OPEN THE CONSOLE? ────────────────────────────────
#
# Found by booting the production image on 2026-09-17: the seed ran, settings
# appeared, and `admin_users` was ZERO. `AdminUser` was created only in the
# sample and e2e seeds, both skipped in production, so a first deploy produced
# a working API with an ops console nobody could log into — and `deploy.yml`'s
# `admin` alias only COUNTS them.
#
# `db/seeds/reference.rb` now seeds one from `ADMIN_PASSWORD` and refuses to
# default it in production. This is the second line of defence: if the seed was
# skipped, or somebody ran `db:prepare` against a database that already
# existed, the console is unreachable and nothing else says so.
step "Ops console"
ADMINS=$(bin/rails runner 'print AdminUser.count' 2>/dev/null)

if [ "$ADMINS" = "0" ]; then
  if [ -n "${APP_BASE_URL:-}${KAMAL_HOST:-}" ] || [ "${RAILS_ENV:-development}" = "production" ]; then
    bad "no admin user exists — the ops console cannot be opened by anybody."
    note "set ADMIN_PASSWORD in .env.production, then: bin/rails db:seed"
  else
    say "  · no admin user yet — /admin cannot be opened."
    note "bin/rails db:seed   (creates ops@karwan.af)"
  fi
elif [ -z "$ADMINS" ]; then
  say "  · could not ask Rails how many admins exist."
else
  ok "$ADMINS admin user(s) can open the console"
fi

# ── A warning, not a failure: SMTP ────────────────────────────────────────
# THE SECOND GATEWAY, and it was invisible until docs/NOTES.md went looking.
# `Users::PasswordResetService` picks its channel from the SHAPE of what was
# typed, so anyone who signs in with an email resets over SMTP rather than SMS.
#
# It fails more quietly than the SMS one and that is the whole reason this
# check exists: `UserMailer#password_reset` is `deliver_later`, so an unset
# host does not fail the request. The endpoint answers 200, the app says
# "check your email", and the code dies in a job nobody is watching. The SMS
# path at least logs the code where somebody can read it.
# WARNS LOCALLY, FAILS ON A DEPLOYED BOX. A laptop has no business holding mail
# credentials and every local run would stop dead if this were a hard failure —
# but on a box with a real hostname, an unset mail host is a password reset that
# answers 200 and goes nowhere. Same signal `APP_BASE_URL` uses above to tell
# "fine locally" from "somebody will actually hit this".
step "SMTP"
if [ -n "${SMTP_ADDRESS:-}" ]; then
  ok "SMTP_ADDRESS=$SMTP_ADDRESS"
elif [ -n "${APP_BASE_URL:-}${KAMAL_HOST:-}" ] || [ "${RAILS_ENV:-development}" = "production" ]; then
  bad "SMTP_ADDRESS is unset on a DEPLOYED box — email password reset would post to localhost."
  note "it fails silently: deliver_later answers the request 200 and the code dies in a job."
  note "Hamma9900 supplies the host, or the reset path ships SMS-only. Do not deploy without one."
else
  say "  · SMTP_ADDRESS is unset — fine locally; a deployed box fails this check."
  note "only reached by an EMAIL reset; a phone reset goes by SMS."
fi

# ── Handover ──────────────────────────────────────────────────────────────
say ""
if [ "$FAILED" = 0 ]; then
  say "Backend ready. The device half is the rig's:"
  METRO=$(curl -s -m 3 "http://localhost:$METRO_PORT/status" 2>/dev/null)
  if [ "$METRO" = "packager-status:running" ]; then
    say "  ✓ metro already on :$METRO_PORT"
  else
    say "  · metro not on :$METRO_PORT yet — qa.sh handles it"
  fi
  say "  6. cd ../karwan-mobile && qa/qa.sh doctor"
  say "  7. qa/qa.sh up      # ONE emulator; three is measured fatal on this box"
  say "  8. qa/qa.sh flows"
  say ""
  say "See docs/RUNBOOK.md for what each step proves."
else
  say "NOT READY — fix the ✗ lines above, in order. Each one blocks the next."
fi

exit "$FAILED"
