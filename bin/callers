#!/usr/bin/env ruby
# For every public method defined outside controllers, who reaches it?
#
#   app_callers  : referenced in app/ or lib/ outside its own file  -> reachable
#   spec_only    : referenced ONLY from spec/                       -> THE FINDING
#   none         : referenced nowhere                               -> dead
#
# Controllers are the entry points, so they are the ROOT, not the subject.
ROOT = File.expand_path(".", __dir__)
Dir.chdir("/home/hama99o/Apps/Personal/Karwan/karwan-api")

# Rails/ActiveRecord/Ruby hooks and overrides: called by the framework, never by name.
FRAMEWORK = %w[
  call to_s to_str as_json to_json inspect initialize each map hash ==
  perform show index create update destroy edit new
  up down change value_type_for_database deserialize serialize cast
  job_kind code name title
].freeze

files = Dir.glob("app/**/*.rb").reject { |f| f.start_with?("app/controllers/") }

defs = {}   # name => [files]
files.each do |file|
  visibility = :public
  File.readlines(file).each_with_index do |line, i|
    visibility = :private  if line =~ /^\s*(private|protected)\s*$/
    visibility = :public   if line =~ /^\s*public\s*$/

    if (m = line.match(/^\s*def\s+self\.([a-z_][\w]*[?!]?)/))
      (defs[m[1]] ||= []) << "#{file}:#{i + 1}"           # class method
    elsif (m = line.match(/^\s*def\s+([a-z_][\w]*[?!]?)/)) && visibility == :public
      (defs[m[1]] ||= []) << "#{file}:#{i + 1}"
    end
  end
end

defs.reject! { |name, _| FRAMEWORK.include?(name) }

# A `def` or `scope` line usually IS a declaration rather than a call, which is
# why they were dropped whole. But **Ruby 3's endless method puts a real call on
# a `def` line** — `def create? = customer? || admin?` — and dropping it reported
# `ApplicationPolicy#customer?` as referenced NOWHERE while two policies call it.
#
# So strip the DECLARATION HEADER and judge what is left. A plain `def foo` has
# nothing left and is still not a caller; an endless one keeps its body.
def without_declaration_header(body)
  body
    .sub(/\A\s*def\s+(?:self\.)?[a-z_][\w]*[?!]?(?:\([^)]*\))?/, "")
    .sub(/\A\s*scope\s+:[a-z_][\w]*[?!]?\s*,?/, "")
end

# ── THE BLIND SPOT A GREP CANNOT CLOSE, SO IT IS DERIVED INSTEAD ─────────────
#
# `Merchants::OrdersController#transition!` authorizes with
# `authorize @order, :"#{to_status}?"` — the symbol is BUILT AT RUNTIME, so no
# literal `ready?` exists anywhere in app/ to find. This reported `OrderPolicy`'s
# `preparing?` and `ready?` as spec-only, and "mark ready" is the merchant's main
# action: deleting it on that advice would raise Pundit::NotDefinedError on every
# tap.
#
# Derived from the `transition!(:x)` call sites rather than hand-listed, so a
# sixth board button is covered the day it is written and a deleted one stops
# excusing its policy method.
DYNAMIC_POLICY_METHODS = `grep -rhoE 'transition!\\(:[a-z_]+' app/controllers --include=*.rb`
  .lines.map { |l| "#{l[/:([a-z_]+)/, 1]}?" }.uniq.freeze

def refs(name, dirs, exclude_files)
  # A trailing `?` or `!` is NOT a word character, so `\b` after it never
  # matches — which made every predicate and bang method look unreferenced.
  tail = name.end_with?("?", "!") ? "" : "\\b"
  pattern = "(\\.|:|\\b)#{Regexp.escape(name)}#{tail}"
  rx = Regexp.new(pattern)
  out = `grep -rnE '#{pattern}' #{dirs.join(' ')} --include=*.rb --include=*.erb 2>/dev/null`
  out.lines.reject { |l| exclude_files.any? { |f| l.start_with?("#{f}:") } }
     .map    { |l| [ l, l.sub(/\A\S+:\d+:/, "") ] }
     .reject { |_, body| body =~ /\A\s*#/ }
     .select { |_, body| rx.match?(without_declaration_header(body)) }
     .map(&:first)
end

spec_only = []
dead = []
defs.each do |name, locations|
  own = locations.map { |l| l.split(":").first }.uniq
  # SAME-FILE CALLERS COUNT. Excluding the defining file answers "is this used
  # outside its class", which is a visibility question. Reachability is a
  # different one, and `OtpVerification.send_allowance` — the OTP billing
  # throttle — is called by `issue!` eleven lines below it.
  in_app = refs(name, %w[app lib config db], [])
  next if in_app.any?
  next if DYNAMIC_POLICY_METHODS.include?(name) && locations.any? { |l| l.include?("app/policies/") }

  in_spec = refs(name, %w[spec], [])
  (in_spec.any? ? spec_only : dead) << [ name, locations, in_spec.size ]
end

puts "PUBLIC METHODS EXAMINED: #{defs.size}"
puts "REACHED FROM app/lib/config/db: #{defs.size - spec_only.size - dead.size}"
puts
puts "══ SPEC-ONLY (#{spec_only.size}) — built and tested, nothing in the app calls them ══"
spec_only.sort_by { |n, _, _| n }.each { |n, l, c| puts format("  %-34s %-46s %d spec refs", n, l.first, c) }
puts
puts "══ NO REFERENCE ANYWHERE (#{dead.size}) ══"
dead.sort_by { |n, _, _| n }.each { |n, l, _| puts format("  %-34s %s", n, l.first) }
