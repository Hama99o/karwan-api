<%# The code is rendered LARGE and on its own line, because it is the only
    thing in this email anybody needs, and it has to survive being read off a
    cracked screen. LTR on the code itself even in an RTL email: a six-digit
    number reversed is a different number. %>
<div dir="<%= @direction %>" style="font-family: sans-serif; font-size: 16px; line-height: 1.6;">
  <p><%= @body_text %></p>

  <p style="direction: ltr; unicode-bidi: isolate; font-size: 32px; font-weight: bold; letter-spacing: 4px; margin: 24px 0;">
    <%= @code %>
  </p>
</div>
