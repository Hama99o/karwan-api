<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Karwan — admin</title>
    <%= csrf_meta_tags %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <style>
      body { font-family: system-ui, sans-serif; background: #f6f6f5; margin: 0;
             display: grid; place-items: center; min-height: 100vh; color: #2b2b2b; }
      .card { background: #fff; padding: 2rem; border-radius: 10px; width: 22rem;
              box-shadow: 0 1px 3px rgba(0,0,0,.12); }
      h1 { font-size: 1.25rem; margin: 0 0 1.25rem; }
      label { display: block; font-size: .8rem; margin-bottom: .25rem; }
      input { width: 100%; padding: .55rem; margin-bottom: 1rem; border: 1px solid #ccc;
              border-radius: 6px; box-sizing: border-box; }
      button { width: 100%; padding: .6rem; border: 0; border-radius: 6px;
               background: #1f4e79; color: #fff; font-size: .95rem; cursor: pointer; }
      .alert { background: #fdecea; color: #8a1c13; padding: .6rem; border-radius: 6px;
               margin-bottom: 1rem; font-size: .85rem; }
      .notice { background: #eaf6ec; color: #1c5c2a; padding: .6rem; border-radius: 6px;
                margin-bottom: 1rem; font-size: .85rem; }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>Karwan — operations</h1>
      <% if flash[:alert] %><div class="alert"><%= flash[:alert] %></div><% end %>
      <% if flash[:notice] %><div class="notice"><%= flash[:notice] %></div><% end %>
      <%= yield %>
    </div>
  </body>
</html>
