# Secrets for Kamal — read from .env.production, which is gitignored.
#
# DO NOT put a raw credential in this file. It is committed; .env.production is
# not. `.gitignore` has `/.env*` and `/config/*.key`, both verified.
KAMAL_REGISTRY_PASSWORD=$(grep '^KAMAL_REGISTRY_PASSWORD=' .env.production | cut -d= -f2-)
RAILS_MASTER_KEY=$(cat config/master.key)
DATABASE_PASSWORD=$(grep '^DATABASE_PASSWORD=' .env.production | cut -d= -f2-)
# The app and the accessory MUST agree, so both read the same line.
POSTGRES_PASSWORD=$(grep '^DATABASE_PASSWORD=' .env.production | cut -d= -f2-)
FCM_PROJECT_ID=$(grep '^FCM_PROJECT_ID=' .env.production | cut -d= -f2-)
FCM_ACCESS_TOKEN=$(grep '^FCM_ACCESS_TOKEN=' .env.production | cut -d= -f2-)
# ── THE TWO GATEWAYS ──────────────────────────────────────────────────────
# Both are Hamma9900's decisions and both cost money, so these lines are
# declared and will resolve to EMPTY until `.env.production` carries them.
# That is deliberate: `bin/preflight` refuses to pass a deployed box without
# SMTP_ADDRESS, so an empty slot fails loudly rather than booting misconfigured.
SMTP_ADDRESS=$(grep '^SMTP_ADDRESS=' .env.production | cut -d= -f2-)
SMTP_USER_NAME=$(grep '^SMTP_USER_NAME=' .env.production | cut -d= -f2-)
SMTP_PASSWORD=$(grep '^SMTP_PASSWORD=' .env.production | cut -d= -f2-)
# `log` in code means codes go to the log and nobody can sign in. The provider
# is chosen on price per message to Afghan networks — his call.
SMS_PROVIDER=$(grep '^SMS_PROVIDER=' .env.production | cut -d= -f2-)
