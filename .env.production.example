# Copy to `.env.production` on the machine that RUNS the deploy (not the server)
# and fill in. `.env.production` is gitignored and must never be committed.

# The VPS. The same OVH box that already runs multi_magic, edu_safi and hatiwal.
KAMAL_HOST=
# The hostname kamal-proxy routes to this app, e.g. api.karwan.af
KAMAL_PROXY_HOST=
SSH_USER=kamal
SSH_KEY_PATH=~/.ssh/id_ed25519

# Docker Hub
KAMAL_REGISTRY_USERNAME=hama99o
KAMAL_REGISTRY_PASSWORD=

# Postgres. Used by BOTH the app and the db accessory — one value, two readers.
DATABASE_PASSWORD=

# Firebase Cloud Messaging. Optional: without it the merchant alert falls back
# to in-app polling and the phone call path, which is by design — push is one of
# three channels, never the channel.
FCM_PROJECT_ID=
FCM_ACCESS_TOKEN=

# WHERE THIS API ANSWERS, used for the absolute URLs in photo and voice-note
# payloads. A native app has no origin, so a host-relative path renders nothing
# — and it looks exactly like "there is no photo", which is why the bug
# survived until a seed attached one.
#
# Falls back to https://$KAMAL_HOST when unset; bin/preflight reports which.
APP_BASE_URL=https://karwan.example.com
